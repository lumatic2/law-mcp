  "name_match": "exact_only",
  "on_name_mismatch": "abort",
  "article_filter": {
    "require_jomun": true,
    "require_title": true,
    "identifier": "조문번호[-가지번호]"
  },
  "selection": {
    "method": "even_interval",
    "sort": "article_number_asc",
    "note": "매칭 목록을 조문번호순으로 정렬한 뒤 균등 간격으로 quota 개를 뽑는다. 오름차순 상위 N 은 총칙 편향을 만들어 쓰지 않는다."
  },
  "underfill_fallback": {
    "method": "even_interval_over_all_titled_articles",
    "note": "1차 필터가 quota 미달이면 표제를 가진 실체 조문 전체에서 같은 간격 샘플링으로 채운다. v1 의 '장(章) 제목 기반 보완'은 폐기됐다 — 조세범 처벌법은 편·장 구조가 없어 조문여부=='전문' 행이 0건이다(2026-08-01 프로브 실측)."
  },
  "duplicate_policy": {
    "against": "bench/corpus.json topic_id",
    "action": "next_interval_candidate"
  },
  "sealed_assignment": {
    "method": "rotating_modulo",
    "primary": "i ≡ k (mod 5)",
    "extra_for_largest": "i ≡ k+2 (mod 5)",
    "largest_count": 8,
    "largest_by": "total_article_count",
    "expected_total": 20,
    "note": "법 인덱스 k(1..12)와 각 법 샘플 순서 i(1..5). 12법에서 1건 + 조문 총수 상위 8법에서 1건 추가 = 20. 봉인 위치가 법마다 회전하므로 봉인이 법 후반부(벌칙·보칙)에 몰려 과적합과 난이도를 분리 못 하게 되는 편향이 없다."
  },
